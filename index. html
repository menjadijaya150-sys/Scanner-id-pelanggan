<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Scan ID Pelanggan</title>

  <script src="https://unpkg.com/html5-qrcode"></script>

  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 20px;
      background: #f2f2f2;
      text-align: center;
    }

    h2 {
      margin-bottom: 20px;
    }

    button {
      width: 100%;
      padding: 15px;
      margin: 8px 0;
      border: 0;
      border-radius: 10px;
      font-size: 17px;
      font-weight: bold;
    }

    #btnKamera {
      background: #1976d2;
      color: white;
    }

    #btnFoto {
      background: #555;
      color: white;
    }

    #btnSimpan {
      background: #168a35;
      color: white;
    }

    #reader {
      width: 100%;
      max-width: 450px;
      margin: 15px auto;
      background: white;
    }

    #idPelanggan {
      width: 100%;
      box-sizing: border-box;
      padding: 15px;
      font-size: 18px;
      border: 1px solid #aaa;
      border-radius: 10px;
      margin: 10px 0;
    }

    #status {
      margin: 15px 0;
      font-weight: bold;
    }
  </style>
</head>

<body>

  <h2>INPUT ID PELANGGAN</h2>

  <button id="btnKamera" onclick="bukaKamera()">
    📷 SCAN DENGAN KAMERA
  </button>

  <button id="btnFoto" onclick="pilihFoto()">
    🖼️ PILIH FOTO BARCODE
  </button>

  <input
    type="file"
    id="fileFoto"
    accept="image/*"
    style="display:none"
    onchange="scanFoto(this)"
  >

  <div id="reader"></div>

  <input
    type="text"
    id="idPelanggan"
    placeholder="ID Pelanggan"
  >

  <button id="btnSimpan" onclick="simpan()">
    💾 SIMPAN
  </button>

  <div id="status"></div>

  <!-- Kirim ke Google Apps Script -->
  <form
    id="formSimpan"
    action="https://script.google.com/macros/s/AKfycbyoiEuE01oVxmuOpdyQt50bqCmJuLi93iYPLMlsv4cYQJ-fSps5671Db6gYz0u502LP9Q/exec"
    method="POST"
    target="hasilSimpan"
    style="display:none"
  >
    <input
      type="hidden"
      name="idPelanggan"
      id="nilaiID"
    >
  </form>

  <iframe
    name="hasilSimpan"
    style="display:none"
  ></iframe>


<script>

let scanner = null;


/* =========================
   KAMERA LANGSUNG
========================= */

async function bukaKamera() {

  document.getElementById("status").innerText =
    "📷 Membuka kamera...";

  scanner = new Html5Qrcode("reader");

  try {

    await scanner.start(

      {
        facingMode: "environment"
      },

      {
        fps: 10,

        qrbox: {
          width: 300,
          height: 150
        }
      },

      async function(barcode) {

        document.getElementById("idPelanggan").value =
          barcode;

        document.getElementById("status").innerText =
          "✅ Barcode terbaca: " + barcode;

        await hentikanKamera();

      },

      function(error) {
        // Abaikan error saat barcode belum terbaca
      }

    );

  } catch (error) {

    document.getElementById("status").innerText =
      "❌ Kamera tidak dapat dibuka. Pastikan izin kamera diberikan.";

  }
}


/* =========================
   HENTIKAN KAMERA
========================= */

async function hentikanKamera() {

  if (scanner) {

    try {
      await scanner.stop();
      scanner.clear();
    } catch (e) {
      // abaikan
    }

    scanner = null;
  }
}


/* =========================
   PILIH FOTO
========================= */

function pilihFoto() {

  document.getElementById("fileFoto").click();

}


/* =========================
   SCAN FOTO
========================= */

async function scanFoto(input) {

  const file = input.files[0];

  if (!file) {
    return;
  }

  document.getElementById("status").innerText =
    "🔍 Membaca barcode dari foto...";

  const pembaca = new Html5Qrcode("reader");

  try {

    const hasil = await pembaca.scanFile(
      file,
      true
    );

    document.getElementById("idPelanggan").value =
      hasil;

    document.getElementById("status").innerText =
      "✅ Barcode terbaca: " + hasil;

  } catch (error) {

    document.getElementById("status").innerText =
      "❌ Barcode tidak terbaca dari foto.";

  }

}


/* =========================
   SIMPAN
========================= */

function simpan() {

  const id =
    document.getElementById("idPelanggan").value.trim();

  if (id === "") {

    document.getElementById("status").innerText =
      "⚠️ ID Pelanggan masih kosong.";

    return;
  }

  document.getElementById("nilaiID").value =
    id;

  document.getElementById("formSimpan").submit();

  document.getElementById("status").innerText =
    "✅ ID Pelanggan berhasil dikirim.";

  document.getElementById("idPelanggan").value = "";

}

</script>

</body>
</html>
